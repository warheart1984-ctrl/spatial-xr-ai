# Spatial XR AI — local config template
# Copy to .env and fill values. Never commit .env.

# Continuity ledger (optional)
# JARVIS_MEMORYBOARD_URL=http://127.0.0.1:8001

# Inference provider (vendor-neutral; pin when deploying)
# SPATIAL_XR_INFERENCE_BASE_URL=
# SPATIAL_XR_INFERENCE_MODEL=

# LOCAL_ONLY is declared until enforced in code
# SPATIAL_XR_LOCAL_ONLY=true
