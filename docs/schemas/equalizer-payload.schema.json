{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spatial-xr-ai.local/schemas/equalizer-payload.schema.json",
  "title": "EqualizerPayload",
  "type": "object",
  "additionalProperties": false,
  "required": ["equalizer_payload"],
  "properties": {
    "equalizer_payload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "threat_decode",
        "negotiation_plan",
        "counter_framing",
        "evidence_gaps"
      ],
      "properties": {
        "threat_decode": { "type": "string", "minLength": 1 },
        "negotiation_plan": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "counter_framing": { "type": "string", "minLength": 1 },
        "evidence_gaps": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
